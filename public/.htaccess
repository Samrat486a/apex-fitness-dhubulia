# Apex Fitness website (public_html/.htaccess on Hostinger · works on Apache and LiteSpeed)
Options -Indexes

# SPA fallback: serve index.html for client-side routes (/dashboard, /admin, …).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Always use HTTPS (logins only work over HTTPS in production). Skipped for local testing.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !^/api/
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_setenvif.c>
  SetEnvIf Request_URI "^/api/" APEX_API
</IfModule>
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self'; frame-src https://www.google.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'" env=!APEX_API
  Header always set X-Frame-Options "SAMEORIGIN" env=!APEX_API
  Header always set X-Content-Type-Options "nosniff" env=!APEX_API
  Header always set Referrer-Policy "strict-origin-when-cross-origin" env=!APEX_API
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
